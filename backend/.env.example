# Salin jadi .env lalu sesuaikan.
APP_TIMEZONE=Asia/Makassar
APP_DEBUG=false

# Laragon: host 127.0.0.1, user root, password kosong.
# Server Linux: boleh pakai socket, mis. DB_SOCKET=/run/mysqld/mysqld.sock
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=resto
DB_USERNAME=root
DB_PASSWORD=

# simulasi = demo tanpa uang sungguhan
PEMBAYARAN_MODE=simulasi

# Alamat Flutter yang boleh memanggil API ("*" = semua; login memakai token, bukan cookie)
CORS_ORIGIN=*
